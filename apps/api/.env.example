# Copia este archivo como .env y rellena los valores.

NODE_ENV=development
PORT=3000

# Cadena de conexion de MongoDB (Atlas o local)
MONGO_URL=mongodb://127.0.0.1:27017/flatfinder

# Secreto de firma de los JWT. Minimo 32 caracteres.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SECRET_KEY=cambia-esto-por-un-secreto-largo-y-aleatorio

JWT_EXPIRES_IN=2h

# Origenes permitidos por CORS, separados por comas.
CORS_ORIGIN=http://localhost:4200
